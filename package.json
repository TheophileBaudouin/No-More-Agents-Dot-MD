    "pi-package",
    "pi",
    "extension",
    "skill",
    "context",
    "hooks"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheophileBaudouin/No-More-Agents-Dot-MD.git"
  },
  "homepage": "https://github.com/TheophileBaudouin/No-More-Agents-Dot-MD",
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "pi": {
    "extensions": [
      ".pi/extensions/context-engine"
    ],
    "skills": [
      "skill/context-engine"
    ],
    "image": "https://raw.githubusercontent.com/TheophileBaudouin/No-More-Agents-Dot-MD/main/assets/image.png"
  }
